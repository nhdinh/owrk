# Application
DEBUG=false
API_PREFIX=/api/v1

# Database - MySQL
DATABASE_USER=admin
DATABASE_PASSWORD_FILE=/run/secrets/mysql_passwd
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=asset_management

# MongoDB (CQRS Read Model)
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USER=admin
MONGO_PASSWD_FILE=/run/secrets/mongo_passwd
MONGODB_DB_NAME=asset_read_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# JWT (for validating tokens from Auth Service)
JWT_SECRET_KEY_FILE=/run/secrets/jwt_secret_key
JWT_ALGORITHM=HS256

# File Upload
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760

# Depreciation Calculation
DEPRECIATION_DAY_OF_MONTH=1

# Auth Service
AUTH_SERVICE_URL=http://auth-api-service:8000
