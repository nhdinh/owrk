# Application
APP_NAME="Asset Management - Auth Service"
ENVIRONMENT=development
DEBUG=True

# Database - PostgreSQL
DATABASE_URL=postgresql://admin:secret123@postgres:5432/asset_management
DB_SCHEMA=auth_db

# MongoDB
MONGODB_URL=mongodb://admin:secret123@mongodb:27017/
MONGODB_DB_NAME=asset_management_read

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Redis
REDIS_URL=redis://redis:6379

# JWT Settings
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# MFA Settings
MFA_ISSUER=AssetManagement
MFA_BACKUP_CODES_COUNT=10

# Active Directory
AD_SERVER=ldap://ad.company.local
AD_DOMAIN=company.local
AD_BIND_DN=CN=admin,DC=company,DC=local
AD_BIND_PASSWORD=ad_password
AD_SEARCH_BASE=OU=Users,DC=company,DC=local
AD_ENABLED=False

# Security
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@company.com
SMTP_PASSWORD=
SMTP_FROM=noreply@company.com
